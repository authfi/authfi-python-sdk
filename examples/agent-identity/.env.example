# Your project's address, as shown in the AuthFI console.
AUTHFI_ISSUER=https://your-project.authfi.io
# The agent's id (agt_...) and the key you registered for it.
AUTHFI_AGENT_ID=
AUTHFI_AGENT_KEY_FILE=./agent.key
# The kid printed by authfi keygen (its public key's thumbprint, unless you chose one).
AUTHFI_AGENT_KID=
